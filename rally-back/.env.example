# Copia este archivo a .env y completa los valores. .env NO se versiona.
FLASK_ENV=development
PORT=5000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rally_db
DB_USER=postgres
DB_PASSWORD=

# Perfil administrador. En Cloud Run, ADMIN_PASSWORD y SECRET_KEY se inyectan desde Secret Manager (--set-secrets).
ADMIN_USER=Etmanuel
ADMIN_PASSWORD=
# Clave para firmar las sesiones (cadena larga y aleatoria; debe ser la misma en todas las instancias)
SECRET_KEY=

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200
